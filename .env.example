# Copy this file to .env.local and fill in the values.

# The site's public address, used for Google listings and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Email enquiries (optional). Without these, enquiries go to WhatsApp instead.
# Get a key at https://resend.com and verify your shop's domain there.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=NOOLAM Website <enquiries@your-domain.com>
ENQUIRY_TO_EMAIL=you@your-domain.com
